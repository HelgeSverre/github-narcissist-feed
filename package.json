{
  "name": "github-narcissist-feed",
  "version": "0.1.0",
  "description": "Your GitHub, about you: stars, forks, issues, pull requests, comments and releases on your repositories, in one Chrome tab.",
  "private": true,
  "type": "module",
  "author": {
    "name": "Helge Sverre",
    "email": "helge.sverre@gmail.com",
    "url": "https://helgesver.re"
  },
  "license": "MIT",
  "homepage": "https://github.com/HelgeSverre/github-narcissist-feed",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelgeSverre/github-narcissist-feed.git"
  },
  "bugs": {
    "url": "https://github.com/HelgeSverre/github-narcissist-feed/issues"
  },
  "keywords": [
    "chrome-extension",
    "github",
    "github-notifications",
    "stars",
    "activity-feed",
    "dashboard",
    "svelte",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "vite build && vitest run --config vitest.e2e.config.ts",
    "icons": "bun scripts/render-icons.ts",
    "dev:web": "vite --mode web",
    "build:web": "vite build --mode web",
    "preview:web": "vite preview --mode web",
    "test:web": "bun run build:web && bun scripts/test-web.ts",
    "clean": "rm -rf dist dist-web coverage .vite node_modules/.vite .cache/e2e-failures"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@puppeteer/browsers": "3.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "22.20.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "puppeteer-core": "25.12.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "idb-keyval": "^6.3.0"
  }
}
